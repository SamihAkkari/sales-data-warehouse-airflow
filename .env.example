### Database related
POSTGRES_HOST = YourDatabaseHost
POSTGRES_PORT = 5432
POSTGRES_USER = YourUser
POSTGRES_PASSWORD = YourPassword
POSTGRES_DB = YourDatabaseName

### Airflow database
AIRFLOW_POSTGRES_HOST = airflow-db # make sure to match the service in docker compose
AIRFLOW_POSTGRES_PORT = 5430
AIRFLOW_POSTGRES_USER = YourAirflowDatabaseUser 
AIRFLOW_POSTGRES_PASSWORD = YourAirflowDatabasePassword
AIRFLOW_POSTGRES_DB = YourAirflowDatabaseName

AIRFLOW_PROJ_DIR=./airflow # make sure to match the directory in your project
AIRFLOW_UID=1000 # make sure to match your user id

PGADMIN_EMAIL = example@example.com
PGADMIN_PASSWORD = YourPGAdminPassword
PGADMIN_PORT = 5050

_AIRFLOW_WWW_USER_USERNAME = YourAirflowUsername
_AIRFLOW_WWW_USER_PASSWORD = YourAirflowPassword

SRC_DIR=./src # make sure to match the directory in your project 
DATASET_DIR=./Dataset # make sure to match the directory in your project